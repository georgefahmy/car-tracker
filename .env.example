# Reolink NVR Connection (Channel 07 "balcony")
NVR_HOST=192.168.68.51
NVR_PORT=554
NVR_CHANNEL=7
NVR_STREAM_TYPE=main
NVR_USER=admin
NVR_PASS=

# Optional local video file for offline testing (overrides RTSP when set)
TEST_VIDEO_PATH=

# Computer Vision & Tracking
YOLO_MODEL=yolov8n.pt
YOLO_IMGSZ=960
CONFIDENCE_THRESHOLD=0.35
TARGET_FPS=3.0
PREVIEW_MAX_WIDTH=1280

# Red-Zone Illegal Parking Rules
DWELL_SECONDS=15.0
MOVEMENT_THRESHOLD=0.015
MIN_TRACK_FRAMES=3

# Server
HOST=0.0.0.0
PORT=8000
DATA_DIR=data
