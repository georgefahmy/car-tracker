[Unit]
Description=Reolink Car & Red-Zone Tracker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_DIR__
Environment=OPENCV_FFMPEG_CAPTURE_OPTIONS=rtsp_transport;tcp
ExecStart=__UV_BIN__ run uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
